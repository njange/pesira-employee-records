# Copy to .env and adjust. Read by docker compose and by the backend.

# Database (docker compose creates it; the backend connects to it)
DB_NAME=records
DB_USERNAME=records
DB_PASSWORD=records
# Host port for PostgreSQL. Change it (and DB_URL) if 5432 is already in use.
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/records

# HMAC key for signing JWTs. Must be at least 32 random bytes, e.g. openssl rand -base64 48
JWT_SECRET=replace-me

# The address the frontend is opened at, for a backend started with mvnw.
# docker compose sets it from FRONTEND_PORT instead.
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Host ports for the backend and frontend containers (docker compose up).
BACKEND_PORT=8080
FRONTEND_PORT=3000
