# Copy to deploy/.env on the VPS and fill in. Never commit deploy/.env.

# Generate each with: openssl rand -base64 48
DB_PASSWORD=replace-me
JWT_SECRET=replace-me

# The Vercel production URL, plus a pattern for its preview deployments.
CORS_ALLOWED_ORIGINS=https://pesira-employee-records-frontend.vercel.app,https://pesira-employee-records-frontend-*.vercel.app

# The localhost port nginx forwards to. Must match proxy_pass in nginx-site.conf.
BACKEND_PORT=5200
